<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Образец</title>
    <style>
      @font-face {
        font-family: 'BureauSerif';
        src: local('Bureau Serif'), local('Bureauserif'), local('bureauserif');
      }
      @font-face {
        font-family: 'BureauSans';
        src: local('Bureau Sans'), local('Bureausans'), local('bureausans');
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        outline: none;
        -webkit-tap-highlight-color: transparent;
        -webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
      }

      body {
        background: transparent;
        font-family: 'BureauSerif', 'Times New Roman', serif;
      }

      .interactive {
        position: relative;
        display: inline-flex;
        align-items: flex-start;
        width: 100%;
        background: transparent;
        box-shadow: none;
      }

      /* --- Thumbnail (left) --- */
      .thumb-wrap {
        position: relative;
        flex: 0 0 100pt;
        width: 100pt;
        cursor: pointer;
        z-index: 1;
      }

      .thumb-img {
        width: 100pt;
        height: auto;
        display: block;
        border: none;
        background: transparent;
      }

      /* --- Full image (hidden by default) --- */
      .full-img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: auto;
        display: none;
        cursor: pointer;
        z-index: 10;
      }

      .expanded .full-img {
        display: block;
      }

      .expanded .thumb-img {
        visibility: hidden;
      }

      /* --- Text block (right) --- */
      .text-block {
        flex: 1 1 auto;
        padding-left: 16pt;
        padding-top: 0;
      }

      .label {
        font-family: 'BureauSerif', 'Times New Roman', serif;
        font-size: 14pt;
        color: #000;
        line-height: 1.2;
        margin-bottom: 6pt;
      }

      .title {
        font-family: 'BureauSans', 'Arial', sans-serif;
        font-size: 18pt;
        color: #c94342;
        line-height: 1.15;
        margin-bottom: 8pt;
        font-weight: normal;
      }

      .divider {
        height: 2pt;
        background-color: #c94342;
        border: none;
        margin-bottom: 8pt;
        width: 100%;
      }

      .hint-row {
        display: flex;
        align-items: center;
        flex-wrap: nowrap;
      }

      .hint-img {
        width: 50pt;
        height: auto;
        margin-right: 10pt;
        flex: 0 0 50pt;
        display: block;
      }

      .hint-text {
        font-family: 'BureauSans', 'Arial', sans-serif;
        font-size: 12pt;
        color: #000;
        line-height: 1.3;
        flex: 1 1 auto;
      }
    </style>
  </head>
  <body>
    <div class="interactive" id="interactive">
      <!-- Thumbnail -->
      <div class="thumb-wrap" id="thumbWrap">
        <img
          src="https://e.profkiosk.ru/service_tbn2/9jbeo0gg0uqb.png"
          alt="Образец"
          class="thumb-img"
          id="thumbImg"
          draggable="false"
        />
        <img
          src="https://e.profkiosk.ru/service_tbn2/9jbeo0gg0uqb.png"
          alt="Образец"
          class="full-img"
          id="fullImg"
          draggable="false"
        />
      </div>

      <!-- Text block -->
      <div class="text-block">
        <div class="label">Образец</div>
        <div class="title">Как юристу защитить себя от личных рисков в банкротстве</div>
        <hr class="divider" />
        <div class="hint-row">
          <img
            src="https://e.profkiosk.ru/service_tbn2/gm29so.png"
            alt=""
            class="hint-img"
            draggable="false"
          />
          <span class="hint-text">Нажмите на картинку слева, чтобы развернуть образец</span>
        </div>
      </div>
    </div>

    <script>
      const interactive = document.getElementById('interactive');
      const thumbWrap = document.getElementById('thumbWrap');
      const thumbImg = document.getElementById('thumbImg');
      const fullImg = document.getElementById('fullImg');

      // Click thumbnail to expand
      thumbWrap.addEventListener('click', function () {
        interactive.classList.add('expanded');
      });

      // Click full image to collapse
      fullImg.addEventListener('click', function () {
        interactive.classList.remove('expanded');
      });

      // Prevent focus on any element
      document.addEventListener('mousedown', function (e) {
        e.preventDefault();
      }, false);
    </script>
  </body>
</html>
